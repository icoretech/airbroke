{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePresets": [":semanticPrefixFixDepsChoreOthers"],
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "semanticCommitScope": "",
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^biome\\.json$/"],
      "matchStrings": [
        "\"\\$schema\"\\s*:\\s*\"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json\""
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "Keep Sentry 10's OpenTelemetry API resolution within its peer range",
      "matchPackageNames": ["@opentelemetry/api"],
      "matchDepTypes": ["resolutions"],
      "allowedVersions": "<1.10.0"
    },
    {
      "description": "Group React runtime updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom"],
      "groupName": "React runtime",
      "groupSlug": "react-runtime"
    },
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "1 day"
    },
    {
      "matchPackageNames": ["ai", "@ai-sdk/react", "@ai-sdk/openai"],
      "groupName": "Vercel AI SDK",
      "groupSlug": "vercel-ai-sdk"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchPackageNames": ["node"],
      "enabled": false
    }
  ]
}
