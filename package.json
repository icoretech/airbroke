    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.40.0",
    "mcp-handler": "2.1.1",
    "nanoid": "6.0.1",
    "next": "16.3.4",
    "numbro": "2.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "react-syntax-highlighter": "16.1.1",
    "recharts": "3.10.1",
