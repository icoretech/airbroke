    "@microlink/react-json-view": "1.31.31",
    "@modelcontextprotocol/server": "2.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/browser": "10.73.0",
    "@sentry/core": "10.73.0",
    "@sentry/node": "10.73.0",
    "ai": "7.0.91",
    "better-auth": "1.7.2",
